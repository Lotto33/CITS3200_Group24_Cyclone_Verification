{
	"compilerOptions": {
		"target": "ES2019",
		"lib": ["ES2019", "DOM", "DOM.Iterable"],
		"module": "none",
		"outDir": "assets",
		"rootDir": "src",
		"strict": true,
		"noImplicitReturns": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"forceConsistentCasingInFileNames": true,
		"removeComments": false,
		"newLine": "lf"
	},
	"include": ["src/**/*.ts"]
}
