# CARTO Basemaps API key, used by visualize.html's basemap tiles.
# Without one, CARTO watermarks every tile with "API KEY REQUIRED".
# Free-tier keys: https://carto.com/basemaps/apikey/
#
# Copy this file to .env (git-ignored), paste your key, then run:
#   python backend/app/build_map_config.py
CARTO_API_KEY=

# --- Backend database -------------------------------------------------------
# SQLAlchemy URL. The default is a local SQLite file under backend/, which
# needs no setup. For PostgreSQL install the extra (`pip install -e
# "backend[postgres]"`) and use e.g.
#   DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/cyclone
DATABASE_URL=sqlite+pysqlite:///./cyclone.db

# Echo every SQL statement (debugging only).
SQL_ECHO=false

# Comma-separated CORS origins for the browser viewers, e.g.
#   BACKEND_CORS_ORIGINS=http://localhost:8000
BACKEND_CORS_ORIGINS=
